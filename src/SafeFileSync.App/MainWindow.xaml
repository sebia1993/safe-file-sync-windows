<Window x:Class="SafeFileSync.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SafeFileSync · 원본 보호 파일 전송" Width="1180" Height="820" MinWidth="900" MinHeight="650" FontSize="13" Background="#F3F6F8">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="SafeFileSync" FontSize="28" FontWeight="Bold" Foreground="#173C50"/><TextBlock Text="원본은 읽기 전용 · 목적지 추가 파일 보존 · 복사 후 검증" Margin="0,4,0,16"/></StackPanel>
  <Grid Grid.Row="1" x:Name="Settings"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="원본 폴더" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="SourcePath" AutomationProperties.Name="원본 폴더 경로" Margin="0,0,8,8"/><Button Grid.Column="2" Content="찾기" Click="BrowseSource" Margin="0,0,0,8"/>
   <TextBlock Grid.Row="1" Text="목적지 폴더" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="DestinationPath" AutomationProperties.Name="목적지 폴더 경로" Margin="0,0,8,8"/><Button Grid.Row="1" Grid.Column="2" Content="찾기" Click="BrowseDestination" Margin="0,0,0,8"/>
   <TextBlock Grid.Row="2" Text="기록 위치" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="StoragePath" AutomationProperties.Name="작업 기록 기준 폴더" Margin="0,0,8,8" TextChanged="StorageChanged" LostKeyboardFocus="StorageFocusLost"/><Button Grid.Row="2" Grid.Column="2" Content="찾기" AutomationProperties.Name="기록 위치 찾기" Click="BrowseStorage" Margin="0,0,0,8"/>
   <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="선택 폴더 아래 SafeFileSync에 기록합니다. 원본·목적지 밖의 쓰기 가능한 폴더를 선택하세요. 재실행 후에는 같은 위치를 선택하면 이력이 나타납니다." TextWrapping="Wrap" Foreground="#52616A" Margin="0,0,0,8"/>
   <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,12"><TextBlock Text="검증 방식" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="Mode" SelectedIndex="0" Width="245"><ComboBoxItem Content="빠른 검증 (크기·수정시간)"/><ComboBoxItem Content="SHA-256 검증 (내용 전체 읽기)"/></ComboBox><CheckBox x:Name="ReplaceExisting" Content="불일치 기존 파일을 검증 후 교체" Margin="24,0,0,0" VerticalAlignment="Center"/></StackPanel>
  </Grid>
  <StackPanel Grid.Row="2"><WrapPanel Margin="0,0,0,12"><Button x:Name="CompareButton" Content="폴더 비교" Click="Compare"/><Button x:Name="CopyButton" Content="복사 시작" Click="Copy"/><Button x:Name="CancelButton" Content="중지" Click="Cancel" IsEnabled="False"/><Button x:Name="RetryButton" Content="선택 작업 실패 항목만 재시도" Click="RetryFailed"/><Button x:Name="ReportButton" Content="결과 보고서" Click="OpenReport" IsEnabled="False"/></WrapPanel><DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Left" Text="작업 이력" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="ResumeButton" DockPanel.Dock="Right" Content="선택 작업 재개 / 재검사·재시도" Click="Resume"/><ComboBox x:Name="History" DisplayMemberPath="Display" AutomationProperties.Name="작업 이력" Margin="0,0,10,0"/></DockPanel></StackPanel>
  <StackPanel Grid.Row="3"><TextBlock x:Name="Status" AutomationProperties.AutomationId="JobStatus" MaxHeight="90" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="기존 폴더를 선택하거나 UNC 경로를 입력하세요. 현재 Windows 로그인 권한을 사용합니다." TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="8" Margin="0,8,0,8"/><TextBlock x:Name="Summary" AutomationProperties.AutomationId="JobSummary" Text="복사 진행률과 검증 결과는 별도로 표시합니다." TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
  <TabControl Grid.Row="4"><TabItem Header="차이 및 검증 결과"><DataGrid x:Name="Differences" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="상대 경로" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="150"/><DataGridTextColumn Header="원본 byte" Binding="{Binding Source}" Width="130"/><DataGridTextColumn Header="목적지 byte" Binding="{Binding Destination}" Width="130"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="양쪽 폴더"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="원본"><TreeView x:Name="SourceTree" AutomationProperties.Name="원본 폴더 내용"/></GroupBox><GroupBox Grid.Column="1" Header="목적지"><TreeView x:Name="DestinationTree" AutomationProperties.Name="목적지 폴더 내용"/></GroupBox></Grid></TabItem></TabControl>
  <TextBlock Grid.Row="5" Margin="0,10,0,0" Foreground="#52616A" TextWrapping="Wrap" Text="화면은 처음 1,000개 항목을 표시하며 전체 결과는 보고서에 저장됩니다. 링크·검사 오류는 완료로 계산하지 않습니다. ACL/ADS 완전 복제는 지원하지 않습니다."/>
 </Grid>
</Window>
