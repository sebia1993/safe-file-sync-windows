<Window x:Class="SafeFileSync.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SafeFileSync · 원본 보호 파일 전송" Width="1180" Height="900" MinWidth="980" MinHeight="760" FontSize="13" Background="#F3F6F8">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.4*" MinHeight="120" MaxHeight="340"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="190"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="SafeFileSync" FontSize="28" FontWeight="Bold" Foreground="#173C50"/><TextBlock Text="원본은 읽기 전용 · 목적지 추가 파일 보존 · 복사 후 검증" Margin="0,4,0,16"/></StackPanel>
  <Grid Grid.Row="1" x:Name="Settings"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="SettingsScroll" AutomationProperties.AutomationId="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
  <StackPanel>
   <DockPanel Margin="0,0,0,8">
    <Button x:Name="AddSourceButton" DockPanel.Dock="Right" Content="원본 추가" AutomationProperties.AutomationId="AddSource" Click="AddSource" Margin="12,0,0,0"/>
    <StackPanel><TextBlock x:Name="SourceCount" AutomationProperties.AutomationId="SourceCount" Text="원본 폴더 1개" FontWeight="SemiBold"/><TextBlock x:Name="SourceLayoutNote" Text="각 원본의 내용은 목적지 안의 지정한 폴더에 따로 저장합니다. 같은 폴더 이름은 변경하세요." Foreground="#52616A" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
   </DockPanel>
   <Grid Margin="8,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="원본 경로"/><TextBlock Grid.Column="1" Text="목적지 안의 폴더 이름"/></Grid>
    <ItemsControl x:Name="SourceItems" AutomationProperties.AutomationId="SourceList"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="White" BorderBrush="#CDD5DA" BorderThickness="1" Padding="7" Margin="0,0,0,6">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{Binding PathAutomationId}" AutomationProperties.Name="{Binding PathLabel}" Margin="0,0,8,0"/>
       <TextBox Grid.Column="1" Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{Binding FolderAutomationId}" AutomationProperties.Name="{Binding FolderLabel}" IsEnabled="{Binding CanEditFolderName}" Margin="0,0,8,0"/>
       <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="찾기" Click="BrowseSource" AutomationProperties.AutomationId="{Binding BrowseAutomationId}" Padding="9,7"/><Button Content="제거" Click="RemoveSource" AutomationProperties.AutomationId="{Binding RemoveAutomationId}" Padding="9,7" Margin="0"/></StackPanel>
       <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Mapping}" AutomationProperties.AutomationId="{Binding MappingAutomationId}" Margin="0,6,0,0" Foreground="#52616A" TextWrapping="Wrap"/>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  </ScrollViewer>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="목적지 폴더" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="DestinationPath" AutomationProperties.AutomationId="DestinationPath" AutomationProperties.Name="목적지 폴더 경로" Margin="0,0,8,8" TextChanged="DestinationChanged"/><Button Grid.Column="2" Content="찾기" Click="BrowseDestination" Margin="0,0,0,8"/>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,12"><TextBlock Text="검증 방식" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="Mode" AutomationProperties.AutomationId="Mode" SelectedIndex="0" Width="245"><ComboBoxItem Content="빠른 검증 (크기·수정시간)"/><ComboBoxItem Content="SHA-256 검증 (내용 전체 읽기)"/></ComboBox><CheckBox x:Name="ReplaceExisting" AutomationProperties.AutomationId="ReplaceExisting" Content="불일치 기존 파일을 검증 후 교체" Margin="24,0,0,0" VerticalAlignment="Center"/></StackPanel>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2"><WrapPanel Margin="0,0,0,12"><Button x:Name="CompareButton" Content="폴더 비교" Click="Compare"/><Button x:Name="CopyButton" Content="복사 시작" Click="Copy"/><Button x:Name="CancelButton" Content="중지" Click="Cancel" IsEnabled="False"/><Button x:Name="RetryButton" Content="선택 작업 실패 항목만 재시도" Click="RetryFailed"/><Button x:Name="ReportButton" Content="결과 보고서" Click="OpenReport" IsEnabled="False"/></WrapPanel><DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Left" Text="작업 이력" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="ResumeButton" DockPanel.Dock="Right" Content="선택 작업 재개 / 재검사·재시도" Click="Resume"/><ComboBox x:Name="History" AutomationProperties.AutomationId="JobHistory" DisplayMemberPath="Display" AutomationProperties.Name="작업 이력" Margin="0,0,10,0"/></DockPanel></StackPanel>
  <StackPanel Grid.Row="3">
   <Border x:Name="SupportPanel" Visibility="Collapsed" Background="#FFF2DD" BorderBrush="#BD7B15" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="오류 코드" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="SupportCode" AutomationProperties.AutomationId="SupportCode" FontSize="20" FontWeight="Bold" Foreground="#824A00"/></StackPanel>
     <TextBlock Grid.Column="1" x:Name="SupportDescription" AutomationProperties.AutomationId="SupportDescription" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <Button Grid.Column="2" x:Name="CopySupportCodeButton" AutomationProperties.AutomationId="CopySupportCode" Content="코드만 복사" Click="CopySupportCode" IsEnabled="False" Padding="12,5" Margin="10,0,0,0"/>
     <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="SupportHint" AutomationProperties.AutomationId="SupportHint" Text="코드만 전달하세요. 복사 내용에는 경로·파일명·로그가 포함되지 않습니다." Foreground="#654E2A" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </Grid>
   </Border>
   <TextBlock x:Name="Status" AutomationProperties.AutomationId="JobStatus" MaxHeight="90" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="기존 폴더를 선택하거나 UNC 경로를 입력하세요. 현재 Windows 로그인 권한을 사용합니다." TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="8" Margin="0,8,0,8"/><TextBlock x:Name="Summary" AutomationProperties.AutomationId="JobSummary" Text="복사 진행률과 검증 결과는 별도로 표시합니다." TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
  <TabControl Grid.Row="4" AutomationProperties.AutomationId="ResultTabs"><TabItem Header="차이 및 검증 결과"><DataGrid x:Name="Differences" AutomationProperties.AutomationId="Differences" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="상대 경로" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="150"/><DataGridTextColumn Header="원본 byte" Binding="{Binding Source}" Width="130"/><DataGridTextColumn Header="목적지 byte" Binding="{Binding Destination}" Width="130"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="양쪽 폴더"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="원본"><TreeView x:Name="SourceTree" AutomationProperties.Name="원본 폴더 내용"/></GroupBox><GroupBox Grid.Column="1" Header="목적지"><TreeView x:Name="DestinationTree" AutomationProperties.Name="목적지 폴더 내용"/></GroupBox></Grid></TabItem></TabControl>
  <TextBlock Grid.Row="5" Margin="0,10,0,0" Foreground="#52616A" TextWrapping="Wrap" Text="화면은 처음 1,000개 항목을 표시하며 전체 결과는 보고서에 저장됩니다. 링크·검사 오류는 완료로 계산하지 않습니다. ACL/ADS 완전 복제는 지원하지 않습니다."/>
 </Grid>
</Window>
